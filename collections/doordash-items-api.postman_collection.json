          "name": "DoorDash Update Item Availability",
          "request": {
            "name": "DoorDash Update Item Availability",
            "description": {
              "content": "Updates the availability status of items and item options for a store. Used to 86 items (mark as unavailable) or stock them back in when they become available to order.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stores",
                ":merchant_supplied_id",
                "item_status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "merchant_supplied_id",
                  "description": "(Required) The merchant-supplied identifier for the store."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": \"<string>\",\n      \"is_available\": \"<boolean>\"\n    },\n    {\n      \"id\": \"<string>\",\n      \"is_available\": \"<boolean>\"\n    }\n  ]\n}",
