{
  "opencollection": "1.0.0",
  "info": {
    "name": "DoorDash Drive Classic Addresses Menus API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Menus",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "DoorDash Create a Menu",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://openapi.doordash.com/drive/v1/menus",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Uploads a complete menu for a store. Menu creation is processed asynchronously. A successful response indicates the request was received. A webhook notification is sent when processing completes or fails."
        },
        {
          "info": {
            "name": "DoorDash Update a Menu",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://openapi.doordash.com/drive/v1/menus/:menu_id",
            "params": [
              {
                "name": "menu_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the menu."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing menu. Uses the same validation as menu creation. Processing is asynchronous with webhook notification upon completion."
        }
      ]
    }
  ],
  "bundled": true
}