          "name": "DoorDash Create a Delivery Quote",
          "request": {
            "name": "DoorDash Create a Delivery Quote",
            "description": {
              "content": "Creates a delivery quote to confirm that a delivery is serviceable by DoorDash and returns the estimated fee and delivery time. Quotes are valid for 5 minutes after creation.",
              "type": "text/plain"
            },
