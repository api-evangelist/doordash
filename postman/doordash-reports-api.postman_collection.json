                  "name": "DoorDash Get Report Download Link",
                  "id": "61fbde66-f9a8-430e-bb53-6a6dd52d1921",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
